{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "bigpharma",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Ambiente de prueba. Se elige al construir (CLOUDFLARE_ENV=qa npm run build): el adaptador de Astro
	// genera dist/client/wrangler.json con este nombre, y `wrangler deploy` no usa --env con esa configuración.
	"env": {
		"qa": {
			"name": "bigpharma-qa"
		}
	}
}