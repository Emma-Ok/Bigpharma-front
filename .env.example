# Copia este archivo como .env (desarrollo) o crea estas variables en Cloudflare Pages
# (Settings → Environment variables). Ver docs/OPERACION.md.

# URL pública del sitio, sin barra al final. Se usa para la URL canónica, el sitemap y los datos estructurados.
SITIO_URL=https://www.tu-drogueria.com

# Pestañas de Google Sheets publicadas como CSV (Archivo → Compartir → Publicar en la web → pestaña → CSV).
# Si una variable está vacía, el sitio usa la copia local datos/<pestaña>.csv.
SHEETS_PRODUCTOS_CSV_URL=
SHEETS_ANUNCIOS_CSV_URL=
SHEETS_CONFIGURACION_CSV_URL=

# 1 = el build falla si la hoja todavía tiene textos [entre corchetes] o un WhatsApp inválido.
# Actívalo en producción cuando la hoja tenga los datos reales.
DATOS_ESTRICTOS=0

# 1 = el servidor de desarrollo revisa cambios por sondeo (solo si la recarga automática no funciona en Docker).
VIGILAR_CON_SONDEO=0
