# Copia este archivo como .env (desarrollo). En producción van como variables de GitHub Actions
# (Settings → Secrets and variables → Actions → Variables). Ver docs/OPERACION.md.

# URL pública del sitio, sin barra al final. Se usa para la URL canónica, el sitemap y los datos estructurados.
SITIO_URL=https://www.tu-drogueria.com

# si = los buscadores pueden indexar el sitio. Vacía (desarrollo, pruebas y despliegues de prueba):
# todas las páginas llevan noindex. Ponla en «si» solo para el lanzamiento real.
SITIO_PUBLICO=

# Pestañas de Google Sheets publicadas como CSV (Archivo → Compartir → Publicar en la web → pestaña → CSV).
# Si una variable está vacía, el sitio usa la copia local datos/<pestaña>.csv.
SHEETS_PRODUCTOS_CSV_URL=
SHEETS_ANUNCIOS_CSV_URL=
SHEETS_CONFIGURACION_CSV_URL=

# estricto = el build falla con campos [por llenar] o avisos de datos; vacía, solo avisa.
# Actívala en las variables de GitHub Actions cuando la hoja tenga los datos reales.
VALIDAR_HOJA=

# 1 = el servidor de desarrollo revisa cambios por sondeo (solo si la recarga automática no funciona en Docker).
VIGILAR_CON_SONDEO=0
