---
import Icono from '@/compartido/ui/Icono.astro';
import { profesionConArticulo, type Configuracion } from '@/dominio/sitio';
import { enlaceWhatsApp, MENSAJE_GENERAL } from '@/dominio/whatsapp';
import PresentacionProfesional from './PresentacionProfesional.astro';

interface Props {
  config: Configuracion;
}

const { config: c } = Astro.props;
const boton = 'inline-flex min-h-12.5 w-full items-center justify-center rounded-boton px-5.5 font-semibold no-underline sm:w-auto';
---

<section id="inicio" aria-labelledby="hero-titulo" data-escenario class="hero relative isolate overflow-hidden">
  <div class="mx-auto grid max-w-sitio md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] md:items-center md:gap-x-12 md:px-margen md:py-[clamp(28px,4vw,52px)]">
    <div class="order-2 flex min-w-0 flex-col px-margen pt-5 pb-7 md:order-none md:px-0 md:py-0">
      <h1 id="hero-titulo" class="m-0 text-[clamp(28px,3.4vw,46px)] leading-[1.12] font-semibold tracking-[-0.01em] text-bottle">
        <span class="hero-linea block" style="--retraso: 0ms">Tus medicamentos,</span>
        <span class="hero-linea block" style="--retraso: 60ms">revisados por {profesionConArticulo(c.profesional.profesion)}</span>
      </h1>
      <p style="--retraso: 120ms" class="hero-linea mt-3.5 mb-0 max-w-[50ch] text-[clamp(16px,1.3vw,18px)] leading-normal text-muted md:mt-6">
        Droguería a domicilio en {c.barrio}. Medicamentos con y sin fórmula, inyectología a domicilio y asesoría sobre tu tratamiento. Armas el pedido aquí y yo lo reviso antes de confirmarte por WhatsApp.
      </p>
      <div style="--retraso: 180ms" class="hero-linea mt-4 flex flex-wrap gap-2.5 md:mt-6">
        <a href="/catalogo" class={`${boton} bg-bottle text-blanco`}>Ver catálogo</a>
        <a href={enlaceWhatsApp(c.whatsapp, MENSAJE_GENERAL)} class={`${boton} border-2 border-bottle bg-blanco text-bottle`}>
          Escribir por WhatsApp
        </a>
      </div>
      <ul aria-label="Datos de la droguería" class="mt-7 mb-0 flex list-none flex-col gap-2 p-0 text-[14.5px] leading-snug md:mt-10">
        <li class="flex items-start gap-2.5">
          <Icono nombre="escudo" class="mt-px text-bottle" />
          Droguería inscrita ante {c.autoridadSalud}, código {c.codigoInscripcion}
        </li>
        <li class="flex items-start gap-2.5">
          <Icono nombre="reloj" class="mt-px text-bottle" />
          Atendemos {c.horario}
        </li>
        <li class="flex items-start gap-2.5">
          <Icono nombre="ubicacion" class="mt-px text-bottle" />
          Domicilio en {c.tiempoEntrega} a {c.zonasCobertura}
        </li>
      </ul>
    </div>

    <PresentacionProfesional config={c} class="order-1 md:order-none" />
  </div>
</section>
