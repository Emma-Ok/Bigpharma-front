---
import Escena3d from '@/compartido/movimiento/3d/Escena3d';
import Boton from '@/compartido/ui/Boton';
import Icono from '@/compartido/ui/Icono.astro';
import type { Configuracion } from '@/dominio/sitio';
import { enlaceWhatsApp, MENSAJE_COTIZACION, MENSAJE_INYECTOLOGIA } from '@/dominio/whatsapp';

interface Props {
  config: Configuracion;
}

const { config } = Astro.props;
const { profesional: p } = config;
// La droguería la atiende una sola persona: los textos van en primera persona del singular.
const pasos = [
  'Envíame por WhatsApp la foto de tu orden médica.',
  'Dime qué día y a qué hora te sirve.',
  'Voy a tu casa y te aplico el medicamento.',
];
const titulo3 = 'm-0 text-[clamp(20px,1.9vw,24px)] leading-snug font-semibold';
---

<section id="servicios" aria-labelledby="serv-titulo" class="bg-celadon">
  <div class="mx-auto flex max-w-sitio flex-col gap-10 px-margen py-[clamp(36px,5vw,60px)]">
  <div class="flex flex-wrap items-start gap-x-14 gap-y-8">
    <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-4">
      <h2 id="serv-titulo" class="m-0 text-[clamp(26px,2.6vw,34px)] leading-tight font-semibold">Servicios</h2>
      <p class="m-0 max-w-[52ch] leading-relaxed text-muted">
        Te atiendo yo, {p.nombre}, {p.profesion.toLowerCase()}.
      </p>
      <h3 class={`${titulo3} mt-2`}>Inyectología en tu casa</h3>
      <p class="m-0 max-w-[52ch] leading-relaxed text-muted">
        Voy a tu casa y te aplico el medicamento inyectable con material estéril y desechable.
      </p>
      <p class="m-0 flex max-w-[52ch] items-start gap-2.5 text-[15.5px] leading-snug font-semibold">
        <Icono nombre="info" class="mt-0.5" />
        Necesitas la orden médica vigente y el medicamento.
      </p>
      <Boton href={enlaceWhatsApp(config.whatsapp, MENSAJE_INYECTOLOGIA)} class="min-w-55 self-start">Agendar visita</Boton>
    </div>
    <div class="flex min-w-0 flex-[1_1_360px] flex-col gap-6">
    <div class="relative h-56 overflow-hidden rounded-panel sm:h-64" aria-hidden="true" data-escenario>
      <!-- Imagen estática (movimiento reducido, sin WebGL o antes de cargar la escena 3D). -->
      <svg class="imagen-estatica absolute inset-0 size-full" viewBox="0 0 400 240" fill="none" stroke-width="2.5" stroke-linejoin="round">
        <g transform="rotate(-36 170 120)" class="stroke-ink">
          <rect x="150" y="30" width="44" height="150" rx="6" class="fill-blanco" />
          <rect x="154" y="92" width="36" height="84" rx="3" class="fill-bottle" />
          <rect x="152" y="80" width="40" height="12" class="fill-ink" />
          <rect x="166" y="-14" width="12" height="94" class="fill-blanco" />
          <rect x="146" y="-22" width="52" height="10" rx="3" class="fill-blanco" />
          <rect x="130" y="24" width="84" height="8" rx="3" class="fill-blanco" />
          <path d="M160 180 L184 180 L178 198 L166 198 Z" class="fill-blanco" />
          <path d="M172 198 V250" stroke-linecap="round" class="stroke-muted" />
        </g>
        <g class="stroke-ink">
          <path d="M268 112 h52 v14 l10 12 v74 a8 8 0 0 1 -8 8 h-56 a8 8 0 0 1 -8 -8 v-74 l10 -12 z" class="fill-blanco" />
          <rect x="270" y="92" width="48" height="22" rx="4" class="fill-bottle" />
          <rect x="260" y="160" width="70" height="30" class="fill-bottle" />
        </g>
      </svg>
      <Escena3d client:visible={{ rootMargin: '300px' }} escena="servicios" />
    </div>
    <ol aria-label="Cómo agendar la inyectología" class="m-0 flex list-none flex-col gap-4.5 p-0">
      {
        pasos.map((paso, i) => (
          <li class="grid grid-cols-[44px_minmax(0,1fr)] items-start gap-3.5">
            <span aria-hidden="true" class="flex size-11 items-center justify-center rounded-full bg-bottle text-lg font-semibold text-blanco">
              {i + 1}
            </span>
            <span class="pt-[9px] leading-normal">{paso}</span>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
    <ul class="m-0 grid list-none gap-x-14 gap-y-8 border-t border-bottle/20 p-0 pt-8 md:grid-cols-2">
      <li class="flex min-w-0 flex-col gap-3">
        <h3 class={titulo3}>Domicilios y aplicación de medicamentos</h3>
        <p class="m-0 max-w-[52ch] leading-relaxed text-muted">
          Te llevo tus medicamentos a la casa en {config.zonasCobertura}. En la misma visita te los puedo aplicar, y también hago
          nebulizaciones y curaciones.
        </p>
        <Boton href="/catalogo" variante="secundario" class="mt-auto min-w-55 self-start">Ver catálogo</Boton>
      </li>
      <li class="flex min-w-0 flex-col gap-3">
        <h3 class={titulo3}>Cotizo tu fórmula</h3>
        <p class="m-0 max-w-[52ch] leading-relaxed text-muted">
          Envíame la foto de tu fórmula médica y te digo el precio. Si hay una opción más económica con el mismo principio activo y
          la misma concentración, te la ofrezco.
        </p>
        <Boton href={enlaceWhatsApp(config.whatsapp, MENSAJE_COTIZACION)} variante="formula" class="mt-auto min-w-55 self-start">
          Cotizar mi fórmula
        </Boton>
      </li>
    </ul>
  </div>
</section>
