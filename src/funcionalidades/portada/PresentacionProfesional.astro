---
// Tarjeta del profesional con la escena 3D alrededor. El canvas y las capas de la imagen estática se ubican
// contra la sección del hero ([data-escenario]): en celular, la banda de 220 px (200 px por debajo de 380 px); en escritorio, toda la altura
// hasta el borde derecho de la ventana.
// La imagen estática (movimiento reducido, sin WebGL o antes de cargar la escena) es SVG en línea, así nunca es
// el LCP, y sale de la misma tabla que la escena (scripts/generar-capsulas.mjs): sus capas se anclan igual que
// las piezas. La del fondo va debajo de la tarjeta, centrada en la foto; las de los bordes, encima.
import celularDerecha from '@/assets/hero-celular-derecha.svg?raw';
import celularIzquierda from '@/assets/hero-celular-izquierda.svg?raw';
import celularTarjeta from '@/assets/hero-celular-tarjeta.svg?raw';
import escritorioDerecha from '@/assets/hero-escritorio-derecha.svg?raw';
import escritorioTarjeta from '@/assets/hero-escritorio-tarjeta.svg?raw';
import Escena3d from '@/compartido/movimiento/3d/Escena3d';
import Icono from '@/compartido/ui/Icono.astro';
import type { Configuracion } from '@/dominio/sitio';

interface Props {
  config: Configuracion;
  class?: string;
}

const { config, class: clase } = Astro.props;
const { profesional: p } = config;
const capa = 'imagen-estatica pointer-events-none absolute size-0';
---

<div class:list={['flex h-55 items-center justify-center max-[23.75rem]:h-50 md:h-auto', clase]}>
  <div class="relative w-[min(328px,calc(100%-24px))] md:w-90">
    <div class={`${capa} top-1/2 left-12 md:hidden`} aria-hidden="true" set:html={celularTarjeta} />
    <div class={`${capa} top-28 left-1/2 hidden md:block`} aria-hidden="true" set:html={escritorioTarjeta} />
    <aside
      id="quien"
      aria-labelledby="quien-titulo"
      data-tarjeta-hero
      class="ficha-profesional relative z-10 flex items-center gap-3 overflow-hidden rounded-[20px] bg-blanco p-3 shadow-ficha md:block md:p-0"
    >
      <div data-foto-hero class="size-18 shrink-0 overflow-hidden rounded-full bg-celadon md:h-56 md:w-full md:rounded-none">
        {
          p.foto ? (
            <img
              src={p.foto}
              alt={`${p.nombre}, ${p.profesion}`}
              width="360"
              height="224"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="block size-full object-cover object-[center_22%]"
            />
          ) : (
            <div class="flex size-full items-end justify-center text-muted/40">
              <svg aria-hidden="true" class="h-[88%] w-auto" viewBox="0 0 230 250" fill="currentColor">
                <circle cx="115" cy="82" r="54" />
                <path d="M14 250 C20 172 62 148 115 148 C168 148 210 172 216 250 Z" />
              </svg>
            </div>
          )
        }
      </div>
      <div class="flex min-w-0 flex-col gap-1 md:gap-2 md:px-5 md:pt-4 md:pb-5">
        <h2 id="quien-titulo" class="m-0 text-[17px] leading-tight font-semibold md:text-[22px]">{p.nombre}</h2>
        <p class="m-0 hidden text-[15px] leading-snug text-muted md:block">{p.profesion}. Atiende personalmente cada pedido.</p>
        <p class="m-0 inline-flex items-center gap-1.5 self-start text-[13px] leading-tight font-semibold text-bottle md:rounded-[10px] md:bg-celadon md:px-2.5 md:py-1 md:text-sm">
          <Icono nombre="escudo" tamano={16} />
          Registro profesional {p.registro}
        </p>
        {
          p.frase && (
            <p class="m-0 mt-1 hidden border-l-[3px] border-bottle pl-2.5 text-[15px] leading-snug text-muted md:block">
              «{p.frase}»
            </p>
          )
        }
      </div>
    </aside>
  </div>
</div>

<div class={`${capa} top-[110px] right-0 z-15 max-[23.75rem]:top-[100px] md:hidden`} aria-hidden="true" set:html={celularDerecha} />
<div class={`${capa} top-[110px] left-0 z-15 max-[23.75rem]:top-[100px] md:hidden`} aria-hidden="true" set:html={celularIzquierda} />
<div class={`${capa} top-1/2 right-0 z-15 hidden md:block`} aria-hidden="true" set:html={escritorioDerecha} />
<Escena3d client:visible escena="hero" class="absolute inset-x-0 top-0 z-20 h-55 max-[23.75rem]:h-50 md:inset-y-0 md:right-0 md:left-[44%] md:h-auto" />
