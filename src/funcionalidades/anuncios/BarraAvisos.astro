---
import Icono from '@/compartido/ui/Icono.astro';
import { enlaceWhatsApp, MENSAJE_GENERAL, numeroVisible } from '@/dominio/whatsapp';

interface Props {
  avisos: string[];
  whatsapp: string;
}

const { avisos, whatsapp } = Astro.props;
---

{
  avisos.length > 0 && (
    <div
      role="region"
      aria-roledescription="carrusel"
      aria-label="Avisos y promociones"
      class="foco-claro bg-bottle text-blanco"
      data-avisos
    >
      <div class="mx-auto flex min-h-11 max-w-sitio items-center gap-1 px-1 sm:px-margen">
        <div class="min-w-0 flex-1 py-1.5">
          <div class="carrusel-pista flex w-full snap-x snap-mandatory overflow-x-hidden" data-aviso-pista>
            {avisos.map((aviso, i) => (
              <p
                role="group"
                aria-roledescription="aviso"
                aria-label={`Aviso ${i + 1} de ${avisos.length}`}
                aria-hidden={i > 0 ? 'true' : undefined}
                inert={i > 0}
                class="m-0 flex w-full shrink-0 snap-start items-center justify-center px-1 text-center text-[14.5px] leading-snug font-medium max-[48rem]:block max-[48rem]:truncate max-[48rem]:text-sm"
              >
                {aviso}
              </p>
            ))}
          </div>
          <p class="visualmente-oculto" aria-live="polite" data-aviso-anuncio />
        </div>
        <a
          href={enlaceWhatsApp(whatsapp, MENSAJE_GENERAL)}
          class="ml-2 hidden min-h-11 shrink-0 items-center gap-2 border-l border-blanco/40 pl-4 text-[14.5px] font-medium text-blanco no-underline lg:inline-flex"
        >
          <Icono nombre="chat" tamano={18} />
          WhatsApp {numeroVisible(whatsapp)}
        </a>
      </div>
    </div>
  )
}

<script>
  import { prefiereMenosMovimiento } from '@/compartido/movimiento/preferencias';
  import { alDetenerse, autoReproducir, conGesto, irA, marcarActual } from './carrusel';

  // Avisos: avanzan solos cada 6 s, sin botón de pausa; se detienen con el puntero, el foco o la pestaña oculta.
  // Con movimiento reducido no se monta nada: queda el primer mensaje.
  document.addEventListener('astro:page-load', () => {
    const barra = document.querySelector<HTMLElement>('[data-avisos]');
    const pista = barra?.querySelector<HTMLElement>('[data-aviso-pista]');
    if (!barra || !pista || pista.children.length < 2) return;
    if (prefiereMenosMovimiento()) return;
    const avisos = [...pista.children] as HTMLElement[];
    const anuncio = barra.querySelector<HTMLElement>('[data-aviso-anuncio]');
    let actual = 0;

    const mostrar = (i: number, anunciar: boolean) => {
      actual = i;
      marcarActual(pista, i);
      if (anunciar && anuncio) anuncio.textContent = `Aviso ${i + 1} de ${avisos.length}: ${avisos[i].textContent?.trim()}`;
    };

    const ir = (paso: number, anunciar: boolean) => {
      const destino = (actual + paso + avisos.length) % avisos.length;
      mostrar(destino, anunciar);
      irA(pista, destino);
    };
    const auto = autoReproducir(barra, () => ir(1, false));
    document.addEventListener('astro:before-swap', () => auto.destruir(), { once: true });
    alDetenerse(pista, (i) => {
      if (i !== actual) mostrar(i, true);
    });
    conGesto(pista, (paso) => {
      ir(paso, true);
      auto.reiniciar();
    });
  });
</script>
