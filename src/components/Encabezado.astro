---
import Icono from './Icono.astro';
import { enlaceWhatsApp, MENSAJE_GENERAL } from '../lib/whatsapp';

interface Props {
  nombre: string;
  whatsapp: string;
}

const { nombre, whatsapp } = Astro.props;
const ruta = Astro.url.pathname;
const enlaces = [
  { href: '/catalogo', texto: 'Catálogo', actual: ruta.startsWith('/catalogo') },
  { href: '/#servicios', texto: 'Inyectables a domicilio', actual: false },
  { href: '/#preguntas', texto: 'Preguntas frecuentes', actual: false },
];
const whatsappUrl = enlaceWhatsApp(whatsapp, MENSAJE_GENERAL);
---

<header class="relative z-40 border-b border-borde-suave bg-blanco" data-encabezado>
  <div class="mx-auto flex max-w-sitio items-center justify-between gap-3 px-margen py-2.5">
    <a href="/" class="flex min-h-11 items-center gap-2.5 text-tinta no-underline">
      <span aria-hidden="true" class="flex size-9.5 shrink-0 items-center justify-center rounded-[11px] bg-azul text-blanco">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 6v12M6 12h12"></path></svg>
      </span>
      <span class="flex flex-col">
        <span class="text-lg leading-tight font-semibold">{nombre}</span>
        <span class="text-[13px] text-texto-2">Droguería a domicilio</span>
      </span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-0.5 lg:flex">
      {
        enlaces.map((e) => (
          <a
            href={e.href}
            aria-current={e.actual ? 'page' : undefined}
            class="inline-flex min-h-11 items-center px-3 text-[15px] font-medium text-tinta no-underline aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
          >
            {e.texto}
          </a>
        ))
      }
      <a
        href="/catalogo#buscar"
        data-abrir-buscador
        aria-haspopup="dialog"
        aria-label="Buscar productos"
        class="ml-1 inline-flex size-11 items-center justify-center rounded-boton border border-texto-2 text-tinta"
      >
        <Icono nombre="lupa" />
      </a>
      <a
        href="/pedido"
        data-contador-enlace
        aria-label="Tu pedido: 0 productos"
        class="relative ml-1 inline-flex size-11 items-center justify-center rounded-boton border border-texto-2 text-tinta"
      >
        <Icono nombre="bolsa" />
        <span
          data-contador-pedido
          aria-hidden="true"
          class="invisible absolute -top-1.5 -right-1.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-azul px-1 text-xs font-bold text-blanco"
          >0</span
        >
      </a>
      <a
        href={whatsappUrl}
        class="ml-2 inline-flex min-h-11 items-center rounded-boton bg-azul px-4.5 text-[15px] font-semibold text-blanco no-underline"
      >
        Escribir por WhatsApp
      </a>
    </nav>

    <div class="flex gap-2 lg:hidden">
      <a
        href="/catalogo#buscar"
        data-abrir-buscador
        aria-haspopup="dialog"
        aria-label="Buscar productos"
        class="flex size-11.5 shrink-0 items-center justify-center rounded-boton border border-texto-2 text-tinta"
      >
        <Icono nombre="lupa" tamano={21} />
      </a>
      <button
        type="button"
        data-menu-boton
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Menú"
        class="flex size-11.5 shrink-0 cursor-pointer items-center justify-center rounded-boton border border-texto-2 bg-blanco text-tinta"
      >
        <Icono nombre="menu" tamano={22} />
      </button>
    </div>
  </div>

  <nav
    id="menu-movil"
    aria-label="Principal"
    class="absolute inset-x-0 top-full max-h-[calc(100dvh-80px)] overflow-y-auto rounded-b-panel border-b border-borde bg-blanco px-margen pb-3 shadow-flotante lg:hidden"
    hidden
    data-menu
  >
    <ul class="m-0 flex list-none flex-col p-0">
      {
        enlaces.map((e) => (
          <li>
            <a
              href={e.href}
              aria-current={e.actual ? 'page' : undefined}
              class="flex min-h-12 items-center border-b border-borde-suave text-[17px] font-medium text-tinta no-underline"
            >
              {e.texto}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/pedido" class="flex min-h-12 items-center border-b border-borde-suave text-[17px] font-medium text-tinta no-underline">
          Tu pedido
        </a>
      </li>
      <li>
        <a href={whatsappUrl} class="flex min-h-12 items-center text-[17px] font-semibold text-azul no-underline">
          Escribir por WhatsApp
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  // Contador del pedido (escritorio): enlace a /pedido con el número de unidades. Es un script y no una
  // isla para que el runtime de islas no quede en medio de la navegación (evita un salto de diseño al cargar).
  import { carritoNavegador, contarUnidades } from '../lib/carrito';

  document.addEventListener('astro:page-load', () => {
    const enlace = document.querySelector<HTMLAnchorElement>('[data-contador-enlace]');
    const insignia = enlace?.querySelector<HTMLElement>('[data-contador-pedido]');
    if (!enlace || !insignia) return;
    const pintar = (unidades: number) => {
      insignia.textContent = String(unidades);
      insignia.classList.toggle('invisible', unidades === 0);
      enlace.setAttribute('aria-label', `Tu pedido: ${unidades === 1 ? '1 producto' : `${unidades} productos`}`);
    };
    const almacen = carritoNavegador();
    pintar(contarUnidades(almacen.leer()));
    const cancelar = almacen.suscribir((c) => pintar(contarUnidades(c)));
    document.addEventListener('astro:before-swap', cancelar, { once: true });
  });

  // Menú de celular: panel superpuesto (no empuja la página), aria-expanded, se cierra con Esc,
  // con un toque fuera o al elegir un enlace; Esc devuelve el foco al botón.
  document.addEventListener('astro:page-load', () => {
    const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!boton || !menu) return;
    const fijar = (abierto: boolean) => {
      boton.setAttribute('aria-expanded', String(abierto));
      menu.hidden = !abierto;
    };
    boton.addEventListener('click', () => fijar(!!menu.hidden));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) fijar(false);
    });
    document.querySelector('[data-encabezado]')?.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Escape' && !menu.hidden) {
        fijar(false);
        boton.focus();
      }
    });
    const fuera = new AbortController();
    document.addEventListener(
      'pointerdown',
      (e) => {
        const objetivo = e.target as Node;
        if (!menu.hidden && !menu.contains(objetivo) && !boton.contains(objetivo)) fijar(false);
      },
      { signal: fuera.signal },
    );
    document.addEventListener('astro:before-swap', () => fuera.abort(), { once: true });
  });
</script>
