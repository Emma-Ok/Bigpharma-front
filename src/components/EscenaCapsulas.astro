---
// Fondo decorativo con cápsulas: imagen estática (SVG en línea, generado con scripts/generar-capsulas.mjs)
// y, cuando conviene, la escena 3D (src/scripts/3d/capsulas.ts, la monta el cargador del layout).
// Es SVG en línea y no <img>: así nunca compite como elemento LCP con el titular.
import capsulas from '../assets/capsulas.svg?raw';

interface Props {
  /** hero: portada; banda: cabeceras (catálogo, 404), sin imagen estática. */
  variante?: 'hero' | 'banda';
}

const { variante = 'hero' } = Astro.props;
const escena = variante === 'hero' ? 'capsulas' : 'banda';
---

<div class="escena-capsulas pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true" data-escena={escena}>
  {
    variante === 'hero' && (
      <div class="capsulas-estaticas absolute inset-0 transition-opacity duration-lenta [&>svg]:size-full" set:html={capsulas} />
    )
  }
</div>

<style>
  .escena-capsulas[data-escena-lista] .capsulas-estaticas {
    opacity: 0;
  }
</style>
