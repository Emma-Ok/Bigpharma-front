---
import '@fontsource-variable/lexend/wght.css';
import '@/styles/global.css';
import lexendLatin from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import BarraAvisos from '@/funcionalidades/anuncios/BarraAvisos.astro';
import Encabezado from './Encabezado.astro';
import Pie from './Pie.astro';
import Buscador from '@/funcionalidades/catalogo/Buscador';
import BarraPedidoMovil from '@/funcionalidades/pedido/BarraPedidoMovil';
import { tiendaDe } from '@/dominio/sitio';
import { cargarDatos, sitioPublico } from '@/hoja/cargarDatos';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica; por defecto la de la página. */
  canonica?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  /** La barra inferior del pedido se oculta en /pedido. */
  sinBarraPedido?: boolean;
}

const { titulo, descripcion, canonica, noindex = false, jsonLd, sinBarraPedido = false } = Astro.props;
const { configuracion } = await cargarDatos();
const tienda = tiendaDe(configuracion);
// Con build.format 'file' la ruta del build trae «.html» («/index.html», «/catalogo.html»); la canónica
// es la ruta limpia que sirve Cloudflare («/», «/catalogo»), la misma del sitemap.
const rutaLimpia = (canonica ?? Astro.url.pathname).replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const urlCanonica = new URL(rutaLimpia, Astro.site).href;
const esquemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Evita que un texto de la hoja cierre la etiqueta <script>.
const aJson = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    {
      !sitioPublico() ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : (
        noindex && <meta name="robots" content="noindex, follow" />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta name="theme-color" content="#133B34" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={lexendLatin} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {esquemas.map((e) => <script type="application/ld+json" set:html={aJson(e)} />)}
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-paper font-sans text-ink antialiased">
    <a
      href="#contenido"
      class="absolute -top-16 left-3 z-50 rounded-boton bg-ink px-4 py-3 font-semibold text-blanco no-underline focus:top-3"
    >
      Saltar al contenido
    </a>
    <BarraAvisos avisos={configuracion.avisos} whatsapp={configuracion.whatsapp} />
    <Encabezado nombre={configuracion.nombreDrogueria} whatsapp={configuracion.whatsapp} />
    <main id="contenido" tabindex="-1" class="flex flex-1 flex-col focus:outline-none">
      <slot />
    </main>
    <Pie config={configuracion} />
    {!sinBarraPedido && <BarraPedidoMovil client:load tienda={tienda} />}
    <Buscador client:idle tienda={tienda} />
    <div id="anuncios-pedido" aria-live="polite" class="visualmente-oculto"></div>
    <script>
      import '@/compartido/movimiento/3d/cargador';
      import { iniciarVolver } from '@/compartido/navegacion/volver';
      import { marcarNavegacionDeProducto } from '@/funcionalidades/producto/transiciones';
      marcarNavegacionDeProducto();
      iniciarVolver();
    </script>
  </body>
</html>
