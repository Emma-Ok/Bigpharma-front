---
import Boton from '@/compartido/ui/Boton';
import Base from '@/layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="La página que buscas no existe." noindex>
  <div class="flex-1 bg-celadon">
    <div class="mx-auto flex w-full max-w-sitio flex-col items-start gap-4 px-margen py-16">
      <h1 class="m-0 text-[clamp(28px,3vw,38px)] leading-tight font-semibold">No encontramos esta página</h1>
      <p class="m-0 max-w-[52ch] text-muted">Puede que el producto ya no esté en el catálogo o que el enlace tenga un error.</p>
      <Boton href="/catalogo">Ver catálogo</Boton>
    </div>
  </div>
</Base>
