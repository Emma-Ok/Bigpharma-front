---
import Base from '@/layouts/Base.astro';
import RutaNavegacion from '@/compartido/ui/RutaNavegacion.astro';
import Catalogo from '@/funcionalidades/catalogo/Catalogo';
import { cargarDatos } from '@/hoja/cargarDatos';
import { resumir } from '@/dominio/producto';
import { migasJsonLd, type Miga } from '@/dominio/seo';
import { tiendaDe } from '@/dominio/sitio';

const { productos, configuracion } = await cargarDatos();
const migas: Miga[] = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Catálogo', ruta: '/catalogo' },
];
---

<Base
  titulo={`Catálogo de productos | ${configuracion.nombreDrogueria}`}
  descripcion="Medicamentos de venta libre, cuidado personal, bebés y primeros auxilios a domicilio. Busca por nombre o síntoma y arma tu pedido por WhatsApp."
  jsonLd={migasJsonLd(migas, Astro.site!)}
>
  <div class="mx-auto flex w-full max-w-sitio flex-col gap-3 px-margen pt-4 pb-14">
    <RutaNavegacion migas={migas} />
    <Catalogo client:load productos={productos.map(resumir)} tienda={tiendaDe(configuracion)} />
  </div>
</Base>
