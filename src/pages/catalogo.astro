---
import Base from '../layouts/Base.astro';
import RutaNavegacion from '../components/RutaNavegacion.astro';
import EscenaCapsulas from '../components/EscenaCapsulas.astro';
import Catalogo from '../components/Catalogo';
import { cargarDatos } from '../lib/datos';
import { resumir } from '../lib/catalogo';
import { migasJsonLd, type Miga } from '../lib/seo';

const { productos, configuracion } = await cargarDatos();
const migas: Miga[] = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: 'Catálogo', ruta: '/catalogo' },
];
const entrega = `Domicilio en ${configuracion.tiempoEntrega} a ${configuracion.zonasCobertura}.`;
---

<Base
  titulo={`Catálogo de productos | ${configuracion.nombreDrogueria}`}
  descripcion="Medicamentos de venta libre, cuidado personal, bebés y primeros auxilios a domicilio. Busca por nombre o síntoma y arma tu pedido por WhatsApp."
  jsonLd={migasJsonLd(migas, Astro.site!)}
>
  <div class="relative isolate overflow-hidden bg-azul-claro">
    <EscenaCapsulas variante="banda" />
    <div class="relative z-10 mx-auto flex min-h-52 w-full max-w-sitio flex-col justify-center gap-2 px-margen pt-4 pb-8">
      <RutaNavegacion migas={migas} />
      <h1 class="m-0 text-[clamp(28px,3vw,38px)] leading-tight font-semibold">Catálogo de productos</h1>
    </div>
  </div>
  <div class="mx-auto flex w-full max-w-sitio flex-col gap-3 px-margen pt-6 pb-14">
    <Catalogo
      client:load
      productos={productos.map(resumir)}
      whatsapp={configuracion.whatsapp}
      entrega={entrega}
    />
  </div>
</Base>
